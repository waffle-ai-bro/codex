{
  "name": "polymarket-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prediction-market bot: Polymarket short-duration crypto Up/Down markets (ResolutionMakerSnipe) with paper trading and replay simulation.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "simulate": "tsx src/apps/simulate.ts",
    "paper:live": "tsx src/apps/paper-live.ts",
    "record": "tsx src/apps/record.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
