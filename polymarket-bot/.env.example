# ---------- app ----------
LOG_LEVEL=info                  # debug | info | warn | error

# ---------- global trading switches (defaults are SAFE: paper only) ----------
TRADING_ENABLED=false           # master switch; must be "true" for ANY live order
LIMITLESS_TRADING_ENABLED=false # second switch required for Limitless live orders
LIMITLESS_DRY_RUN=true          # build+sign+log orders without submitting

# ---------- Polymarket (public market data needs NO keys) ----------
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com

# ---------- Limitless (Base) ----------
LIMITLESS_API_BASE=https://api.limitless.exchange
LIMITLESS_WS_BASE=wss://ws.limitless.exchange
# API key for authenticated REST (profile, orders). Create in the Limitless UI.
LIMITLESS_API_KEY=
# EOA private key used ONLY to sign orders (EIP-712). Use a dedicated hot
# wallet with small funds. Never commit. Never needed for paper mode.
LIMITLESS_PRIVATE_KEY=
# Optional pin/override; normally the verifying contract is read from the
# market's venue data (market.venue.exchange).
LIMITLESS_VERIFYING_CONTRACT=
LIMITLESS_DOMAIN_NAME=Limitless CTF Exchange
LIMITLESS_DOMAIN_VERSION=1
LIMITLESS_CHAIN_ID=8453
LIMITLESS_ORDER_TYPE=GTC        # GTC | GTD (GTD = GTC + expiration)
LIMITLESS_ORDER_TTL_SEC=120
